# Name: Ptinopedila Core
# Description: Essential shell and workstation administration tools.
# Category: Foundation
# Install policy: automatic

tap "chmouel/raffi", trusted: true

brew "bat"
brew "btop"
brew "fd"
brew "fzf"
brew "glow"
brew "htop"
brew "jq"
brew "lsd"
brew "procs"
brew "pv"
brew "chmouel/raffi/raffi", trusted: true
brew "rclone"
brew "restic"
brew "ripgrep"
brew "starship"
brew "tcpdump"
brew "tealdeer"
brew "tmux"
brew "ykman"
brew "zsh-autosuggestions"
brew "zsh-fast-syntax-highlighting"
