#!/usr/bin/env bash

set -Eeuo pipefail

# Install a dotfiles repository using the bare-repository setup described at:
# https://www.atlassian.com/git/tutorials/dotfiles

usage() {
    cat >&2 <<EOF
Usage:
  $0 <repository-url>
  $0 --github <username> <repository>

Examples:
  $0 git@github.com:octocat/dotfiles.git
  $0 git@gitlab.com:octocat/dotfiles.git
  $0 --github octocat dotfiles
EOF
}

if ! command -v git >/dev/null 2>&1; then
    echo "This script requires git." >&2
    exit 1
fi

case $# in
    1)
        repository_url=$1
        ;;
    3)
        if [[ $1 != "--github" ]]; then
            usage
            exit 1
        fi

        username=$2
        repository=${3%.git}
        if [[ ! $username =~ ^[A-Za-z0-9-]+$ ||
              ! $repository =~ ^[A-Za-z0-9._-]+$ ]]; then
            echo "Invalid GitHub username or repository name." >&2
            exit 1
        fi
        repository_url="git@github.com:${username}/${repository}.git"
        ;;
    *)
        usage
        exit 1
        ;;
esac

git_dir="$HOME/.cfg"

if [[ -e $git_dir || -L $git_dir ]]; then
    echo "Refusing to replace existing path: $git_dir" >&2
    exit 1
fi

# Clone and inspect the repository away from HOME. Nothing in HOME is changed if
# cloning fails or the repository is empty.
staging_dir=$(mktemp -d)
trap 'rm -rf -- "$staging_dir"' EXIT
staged_git_dir="$staging_dir/.cfg"

git clone --quiet --bare "$repository_url" "$staged_git_dir"

if ! git --git-dir="$staged_git_dir" rev-parse --verify --quiet HEAD >/dev/null; then
    echo "The dotfiles repository has no commit to check out." >&2
    exit 1
fi

mapfile -d '' tracked_paths < <(
    git --git-dir="$staged_git_dir" ls-tree -rz --name-only HEAD
)

for path in "${tracked_paths[@]}"; do
    if [[ $path == ".cfg" || $path == .cfg/* ]]; then
        echo "The repository tracks '$path', which would overlap $git_dir." >&2
        exit 1
    fi
done

backup_dir=""
backup_count=0

backup_path() {
    local relative_path=$1
    local source_path="$HOME/$relative_path"
    local destination_path

    if [[ ! -e $source_path && ! -L $source_path ]]; then
        return
    fi

    if [[ -z $backup_dir ]]; then
        backup_dir=$(mktemp -d "$HOME/.config-backup.XXXXXXXX")
    fi

    destination_path="$backup_dir/$relative_path"
    mkdir -p -- "${destination_path%/*}"
    mv -- "$source_path" "$destination_path"
    backup_count=$((backup_count + 1))
    printf 'Backed up %q\n' "$relative_path"
}

for path in "${tracked_paths[@]}"; do
    current_path=""
    parent_path=${path%/*}

    # If an ancestor that needs to be a directory is currently a file or a
    # symlink, back up that ancestor as a unit. This also avoids following a
    # symlink and modifying a location outside HOME.
    if [[ $parent_path != "$path" ]]; then
        remaining_path=$parent_path
        while [[ -n $remaining_path ]]; do
            if [[ $remaining_path == */* ]]; then
                part=${remaining_path%%/*}
                remaining_path=${remaining_path#*/}
            else
                part=$remaining_path
                remaining_path=""
            fi

            if [[ -n $current_path ]]; then
                current_path+="/$part"
            else
                current_path=$part
            fi

            if [[ -L "$HOME/$current_path" ||
                  ( -e "$HOME/$current_path" && ! -d "$HOME/$current_path" ) ]]; then
                backup_path "$current_path"
                break
            fi
        done
    fi

    backup_path "$path"
done

mv -- "$staged_git_dir" "$git_dir"

dotfiles_git() {
    git --git-dir="$git_dir" --work-tree="$HOME" "$@"
}

dotfiles_git checkout
dotfiles_git config --local status.showUntrackedFiles no

echo "Installed dotfiles from $repository_url"
if (( backup_count > 0 )); then
    echo "Backed up $backup_count pre-existing path(s) to $backup_dir"
else
    echo "No pre-existing dotfiles needed to be backed up."
fi
