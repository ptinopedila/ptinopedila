#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
    cat <<EOF
Usage: ${0##*/} [--distribution miniconda|anaconda] [--prefix PATH] [--dry-run]

Install the latest Miniconda or Anaconda distribution for this Linux machine.

Options:
  -d, --distribution NAME  Distribution to install (default: miniconda)
  -p, --prefix PATH        Installation directory
                           (default: \$HOME/.local/anaconda3)
      --dry-run            Resolve the installer and checksum without installing
  -h, --help               Show this help

The installer does not modify shell startup files or activate the base
environment. An existing installation is left unchanged.
EOF
}

if [[ -z ${HOME:-} ]]; then
    echo "HOME must be set to install Conda for the current user." >&2
    exit 1
fi

distribution="miniconda"
install_prefix="${HOME}/.local/anaconda3"
dry_run=false

while (( $# > 0 )); do
    case "$1" in
        -d|--distribution)
            if (( $# < 2 )); then
                echo "Missing value for $1." >&2
                usage >&2
                exit 2
            fi
            distribution=${2,,}
            shift 2
            ;;
        --distribution=*)
            distribution=${1#*=}
            distribution=${distribution,,}
            shift
            ;;
        -p|--prefix)
            if (( $# < 2 )); then
                echo "Missing value for $1." >&2
                usage >&2
                exit 2
            fi
            install_prefix=$2
            shift 2
            ;;
        --prefix=*)
            install_prefix=${1#*=}
            shift
            ;;
        --dry-run)
            dry_run=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

case "$distribution" in
    miniconda|anaconda) ;;
    *)
        echo "Unsupported distribution: $distribution" >&2
        echo "Choose 'miniconda' or 'anaconda'." >&2
        exit 2
        ;;
esac

if [[ $install_prefix != /* ]]; then
    echo "The installation prefix must be an absolute path." >&2
    exit 2
fi

if [[ -x "$install_prefix/bin/conda" ]]; then
    echo "Conda is already installed at $install_prefix; nothing to do."
    exit 0
fi

if [[ -e "$install_prefix" || -L "$install_prefix" ]]; then
    echo "Refusing to replace an existing path without a Conda installation:" >&2
    echo "  $install_prefix" >&2
    exit 1
fi

for required_command in awk bash curl mkdir mktemp rm sha256sum uname; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        echo "Required command not found: $required_command" >&2
        exit 1
    fi
done

if [[ $(uname -s) != "Linux" ]]; then
    echo "This installer currently supports Linux only." >&2
    exit 1
fi

machine_arch=$(uname -m)
case "$machine_arch" in
    x86_64|amd64) installer_arch="x86_64" ;;
    aarch64|arm64) installer_arch="aarch64" ;;
    s390x) installer_arch="s390x" ;;
    ppc64le) installer_arch="ppc64le" ;;
    *)
        echo "No Conda installer mapping for architecture: $machine_arch" >&2
        exit 1
        ;;
esac

case "$distribution" in
    miniconda)
        repository_url="https://repo.anaconda.com/miniconda"
        installer_name="Miniconda3-latest-Linux-${installer_arch}.sh"
        ;;
    anaconda)
        repository_url="https://repo.anaconda.com/archive"
        installer_name=""
        ;;
esac

download_dir=$(mktemp -d "${TMPDIR:-/tmp}/conda-install.XXXXXXXX")
trap 'rm -rf -- "$download_dir"' EXIT
index_file="$download_dir/index.html"

curl_options=(
    --fail
    --location
    --proto '=https'
    --retry 3
    --retry-delay 2
    --show-error
    --silent
)

echo "Reading the official $distribution installer index..."
curl "${curl_options[@]}" --output "$index_file" "$repository_url/"

if [[ $distribution == "anaconda" ]]; then
    installer_name=$(awk -v suffix="-Linux-${installer_arch}.sh" '
        match($0, /href="Anaconda3-[^"]+"/) {
            name = substr($0, RSTART + 6, RLENGTH - 7)
            if (length(name) >= length(suffix) &&
                substr(name, length(name) - length(suffix) + 1) == suffix) {
                print name
                exit
            }
        }
    ' "$index_file")
fi

if [[ -z $installer_name ]]; then
    echo "No current $distribution installer was found for $installer_arch." >&2
    exit 1
fi

installer_sha256=$(awk -v installer="$installer_name" '
    function collect_checksums(line, remainder) {
        remainder = line
        while (match(remainder, /[0-9a-fA-F]{64}/)) {
            checksum_count++
            checksum = substr(remainder, RSTART, RLENGTH)
            remainder = substr(remainder, RSTART + RLENGTH)
        }
    }

    index($0, "href=\"" installer "\"") {
        matching_rows++
        in_matching_row = 1
        collect_checksums($0)
        if (/<\/tr>/) {
            in_matching_row = 0
        }
        next
    }

    in_matching_row {
        collect_checksums($0)
        if (/<\/tr>/) {
            in_matching_row = 0
        }
    }

    END {
        if (matching_rows == 1 && checksum_count == 1) {
            print checksum
        }
    }
' "$index_file")

if [[ ! $installer_sha256 =~ ^[0-9a-fA-F]{64}$ ]]; then
    echo "Could not read the SHA-256 checksum for $installer_name." >&2
    exit 1
fi

echo "Selected installer: $installer_name"
echo "SHA-256: $installer_sha256"

if [[ $dry_run == true ]]; then
    exit 0
fi

installer_path="$download_dir/$installer_name"
echo "Downloading $installer_name..."
curl "${curl_options[@]}" --output "$installer_path" \
    "$repository_url/$installer_name"

echo "Verifying SHA-256 checksum..."
if ! printf '%s  %s\n' "$installer_sha256" "$installer_path" |
    sha256sum --check --status; then
    echo "Checksum verification failed for $installer_name." >&2
    exit 1
fi

install_parent=${install_prefix%/*}
[[ -n $install_parent ]] || install_parent="/"
mkdir -p -- "$install_parent"

echo "Installing $distribution at $install_prefix..."
bash "$installer_path" -b -p "$install_prefix"

if [[ ! -x "$install_prefix/bin/conda" ]]; then
    echo "The installer finished, but $install_prefix/bin/conda is missing." >&2
    exit 1
fi

echo
"$install_prefix/bin/conda" --version
echo "Installation complete. Shell startup files were not modified."
